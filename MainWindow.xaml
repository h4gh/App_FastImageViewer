                                Style="{StaticResource FlyoutMenuButtonStyle}"
                                Content="＋ Přiblížit"
                                Tag="+"
                                Click="FlyoutZoomInButton_Click" />
                        <Button Grid.Column="2"
                                Style="{StaticResource FlyoutMenuButtonStyle}"
                                Content="－ Oddálit"
                                Tag="-"
                                Click="FlyoutZoomOutButton_Click" />
                    </Grid>

                    <Button Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="🔍 Skutečná velikost 1:1"
                            Tag="*"
                            Click="FlyoutZoom100Button_Click" />
                    <Button Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="⛶ Přizpůsobit oknu (Fit)"
                            Tag="/"
                            Click="FlyoutZoomFitButton_Click" />
                    <Button x:Name="FlyoutWheelModeButton"
                            Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="🖱 Kolečko: Listování"
                            Tag="M"
                            Click="WheelModeButton_Click" />

                    <Separator Background="#2D2D35" Margin="4,7" />

                    <!-- Section 3: Úpravy a výstřižky -->
                    <TextBlock Text="ÚPRAVY A VÝŘEZ"
                               Foreground="#60A5FA"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Margin="8,0,0,4" />

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource FlyoutMenuButtonStyle}"
                                Content="⟲ Doleva"
                                Tag="L"
                                Click="FlyoutRotateLeftButton_Click" />
                        <Button Grid.Column="2"
                                Style="{StaticResource FlyoutMenuButtonStyle}"
                                Content="⟳ Doprava"
                                Tag="R"
                                Click="FlyoutRotateRightButton_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource FlyoutMenuButtonStyle}"
                                Content="⇄ Zrcadlit H"
                                Tag="H"
                                Click="FlyoutFlipHButton_Click" />
                        <Button Grid.Column="2"
                                Style="{StaticResource FlyoutMenuButtonStyle}"
                                Content="⇅ Zrcadlit V"
                                Tag="V"
                                Click="FlyoutFlipVButton_Click" />
                    </Grid>

                    <Button Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="✂ Výstřižek oblasti (Crop)"
                            Tag="X"
                            Click="FlyoutCropButton_Click" />

                    <Button x:Name="FlyoutEditSaveModeButton"
                            Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="💾 Ukládání: Auto sufix"
                            Tag="U"
                            Click="EditSaveModeButton_Click" />

                    <Separator Background="#2D2D35" Margin="4,7" />

                    <!-- Section 4: Správa souboru -->
                    <TextBlock Text="SOUBOR"
                               Foreground="#60A5FA"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Margin="8,0,0,4" />

                    <Button Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="📋 Kopírovat do složky..."
                            Tag="C"
                            Click="FlyoutCopyButton_Click" />
                    <Button Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="⚡ Dávková konverze..."
                            Tag="B / F3"
                            Click="BatchConvertButton_Click" />
                    <Button Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="🗑 Smazat do Koše"
                            Tag="Del"
                            Foreground="#F87171"
                            Click="FlyoutDeleteButton_Click" />
                    <Button Style="{StaticResource FlyoutMenuButtonStyle}"
                            Content="✕ Ukončit prohlížeč"
                            Tag="Esc"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Border>

            <!-- ==================== RIGHT-EDGE AUTO-HIDE EXIF & FILE DETAILS PANEL ==================== -->
            <Border x:Name="RightExifPanel"
                    Width="352"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#F418181B"
                    BorderBrush="#3B82F6"
                    BorderThickness="1,1,0,1"
                    CornerRadius="10,0,0,10"
                    Padding="12,10,12,12"
                    Visibility="Collapsed"
                    MouseLeave="RightExifPanel_MouseLeave"
                    PreviewMouseWheel="RightExifPanel_PreviewMouseWheel">
                <StackPanel>
                    <!-- Panel Header -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="📊 SOUBOR A EXIF (I)"
                                   Foreground="#60A5FA"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Style="{StaticResource FilmstripNavButtonStyle}"
                                Content="📋 Souhrn"
                                ToolTip="Zkopírovat souhrn parametrů fotky a EXIF do schránky"
                                Padding="7,3"
                                FontSize="11"
                                Margin="0,0,5,0"
                                Click="ExifCopySummaryButton_Click" />

                        <Button x:Name="RightExifPinButton"
                                Grid.Column="2"
                                Style="{StaticResource FilmstripNavButtonStyle}"
                                Content="📌 Připnout"
                                ToolTip="Připnout pravý EXIF panel natrvalo (nebo klávesa I)"
                                Padding="7,3"
                                FontSize="11"
                                Click="RightExifPinButton_Click" />
                    </Grid>

                    <!-- Section 1: File and Attributes -->
                    <Border Background="#212229"
                            BorderBrush="#2E303B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ExifFileNameText"
                                           Grid.Column="0"
                                           Text="Obrázek"
                                           Foreground="#F3F4F6"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="📋"
                                        ToolTip="Zkopírovat celou cestu k souboru"
                                        Padding="6,2"
                                        FontSize="11"
                                        Margin="6,0,0,0"
                                        Click="ExifCopyPathButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ExifLocationText"
                                           Grid.Column="0"
                                           Text="—"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="📂 Průzkumník"
                                        ToolTip="Ukázat soubor v Průzkumníku Windows"
                                        Padding="6,2"
                                        FontSize="11"
                                        Margin="6,0,0,0"
                                        Click="ExifOpenExplorerButton_Click" />
                            </Grid>

                            <Separator Background="#2D2F3A" Margin="0,0,0,5" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Typ:" Foreground="#8B92A1" FontSize="11" Margin="0,1" />
                                <TextBlock x:Name="ExifFileTypeText" Grid.Row="0" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Velikost:" Foreground="#8B92A1" FontSize="11" Margin="0,1" />
                                <TextBlock x:Name="ExifFileSizeText" Grid.Row="1" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Změněno:" Foreground="#8B92A1" FontSize="11" Margin="0,1" />
                                <TextBlock x:Name="ExifFileDateText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rozměry:" Foreground="#8B92A1" FontSize="11" Margin="0,1" />
                                <TextBlock x:Name="ExifDimensionsText" Grid.Row="3" Grid.Column="1" Text="—" Foreground="#93C5FD" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tisk / DPI:" Foreground="#8B92A1" FontSize="11" Margin="0,1" />
                                <TextBlock x:Name="ExifPrintSizeText" Grid.Row="4" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Quick Photo Summary -->
                    <Border x:Name="ExifQuickSummaryBorder"
                            Background="#1E293B"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="0,0,0,6"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ExifQuickSummaryText"
                                   Foreground="#93C5FD"
                                   FontWeight="SemiBold"
                                   FontSize="11.5"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Section 3: EXIF Table -->
                    <Border Background="#1B1C22"
                            BorderBrush="#2A2D38"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9,6"
