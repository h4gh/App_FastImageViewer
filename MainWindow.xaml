                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="FlyoutFileNameText"
                                       Text="Obrázek"
                                       Foreground="#F3F4F6"
                                       FontWeight="SemiBold"
                                       FontSize="13"
