                                        Foreground="#93C5FD"
                                        FontWeight="SemiBold"
                                        Padding="8,3.5"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        Click="ExifOpenGoogleMapsButton_Click" />
                                <Button Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="📋 Kopírovat"
                                        ToolTip="Zkopírovat GPS souřadnice do schránky"
                                        Padding="8,3.5"
                                        FontSize="11"
                                        Click="ExifCopyGpsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== TOP-EDGE AUTO-HIDE FILMSTRIP PANEL (FastStone style) ==================== -->
            <Border x:Name="TopFilmstripPanel"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="#F418181B"
                    BorderBrush="#3B82F6"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed"
                    MouseLeave="TopFilmstripPanel_MouseLeave"
                    MouseWheel="TopFilmstripPanel_MouseWheel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Control Bar -->
                    <Border Grid.Row="0"
                            Background="#1E1E24"
                            BorderBrush="#2B2F3A"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Quick Jump Navigation -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="FilmstripFirstButton"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="⏮ První (Home)"
                                        ToolTip="Skočit okamžitě na 1. fotku ve složce (Home)"
                                        Background="#263B5E"
                                        BorderBrush="#3B82F6"
                                        Foreground="#93C5FD"
                                        FontWeight="SemiBold"
                                        Margin="0,0,6,0"
                                        Click="FilmstripFirstButton_Click" />
                                <Button x:Name="FilmstripPrevButton"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="◀"
                                        ToolTip="Předchozí fotka (←)"
                                        Margin="0,0,4,0"
                                        Click="FlyoutPrevButton_Click" />
                                <Button x:Name="FilmstripNextButton"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="▶"
                                        ToolTip="Další fotka (→)"
                                        Margin="0,0,6,0"
                                        Click="FlyoutNextButton_Click" />
                                <Button x:Name="FilmstripLastButton"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="Poslední (End) ⏭"
                                        ToolTip="Skočit na poslední fotku ve složce (End)"
                                        Margin="0,0,6,0"
                                        Click="FilmstripLastButton_Click" />
                                <Button x:Name="FilmstripCenterButton"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="🎯 Na aktivní"
                                        ToolTip="Vycentrovat pás miniatur zpět na právě otevřenou fotku"
                                        Click="FilmstripCenterButton_Click" />
                            </StackPanel>

                            <!-- Center: Folder & Counter Info -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <TextBlock x:Name="FilmstripFolderPathText"
                                           Foreground="#D1D5DB"
                                           FontSize="12"
                                           MaxWidth="320"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border Background="#252B3B"
                                        BorderBrush="#374151"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="9,2"
                                        Margin="10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="FilmstripCounterText"
                                               Text="0 / 0 fotek"
                                               Foreground="#60A5FA"
                                               FontSize="11.5"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="FilmstripResolutionText"
                                           Foreground="#9CA3AF"
                                           FontSize="11.5"
                                           MaxWidth="260"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right: Thumbnail Scale, Sorting, Pin & Overview -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ComboBox x:Name="FilmstripSizeComboBox"
                                          Width="132"
                                          Margin="0,0,8,0"
                                          ToolTip="Nastavení velikosti náhledů a popisků v horním pásu (nebo Ctrl + kolečko myši)"
                                          Style="{StaticResource FilmstripComboBoxStyle}"
                                          Focusable="False"
                                          SelectionChanged="FilmstripSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Náhledy: 75 %" Tag="75" />
                                    <ComboBoxItem Content="Náhledy: 90 %" Tag="90" />
                                    <ComboBoxItem Content="Náhledy: 100 %" Tag="100" />
                                    <ComboBoxItem Content="Náhledy: 115 %" Tag="115" />
                                    <ComboBoxItem Content="Náhledy: 125 %" Tag="125" />
                                    <ComboBoxItem Content="Náhledy: 150 %" Tag="150" />
                                    <ComboBoxItem Content="Náhledy: 175 %" Tag="175" />
                                    <ComboBoxItem Content="Náhledy: 200 %" Tag="200" />
                                </ComboBox>
                                <ComboBox x:Name="FilmstripSortComboBox"
                                          Width="215"
                                          Margin="0,0,8,0"
                                          ToolTip="Rychlá změna řazení fotek podle Průzkumníku Windows"
                                          Style="{StaticResource FilmstripComboBoxStyle}"
                                          Focusable="False"
                                          SelectionChanged="SortComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Řazení: Název A–Z (Přirozené)" />
                                    <ComboBoxItem Content="Řazení: Název Z–A" />
                                    <ComboBoxItem Content="Řazení: Datum (Nejnovější první)" />
                                    <ComboBoxItem Content="Řazení: Datum (Nejstarší první)" />
                                    <ComboBoxItem Content="Řazení: Velikost (Největší)" />
                                </ComboBox>
                                <Button x:Name="FilmstripPinButton"
                                        Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="📌 Připnout"
                                        ToolTip="Připnout pás miniatur natrvalo nahoře, aby se sám neschovával"
                                        Margin="0,0,8,0"
                                        Click="FilmstripPinButton_Click" />
                                <Button Style="{StaticResource FilmstripNavButtonStyle}"
                                        Content="⊞ Přehled (Esc)"
                                        ToolTip="Přepnout do třípanelového Přehledu (Enter / Esc)"
                                        Click="FlyoutOverviewButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Horizontal Virtualized Thumbnail Strip -->
                    <ListBox x:Name="FilmstripListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,6,8,4"
                             SelectionMode="Single"
                             Focusable="False"
                             ItemContainerStyle="{StaticResource FilmstripListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewMouseWheel="FilmstripListBox_PreviewMouseWheel"
                             SelectionChanged="FilmstripListBox_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ImageItem}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="21" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#111216"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   StretchDirection="DownOnly"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Background="#CC0F172A"
                                                    CornerRadius="3"
                                                    Padding="5,1.5"
                                                    Margin="4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding IndexBadgeText}"
                                                           Foreground="#60A5FA"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           FontFamily="Consolas" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="1,2,1,0">
                                        <TextBlock Text="{Binding DimensionsText}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Foreground="#9CA3AF"
                                                   FontSize="10.5"
                                                   FontFamily="Consolas" />
                                        <TextBlock Text="{Binding ExtensionBadge}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#60A5FA"
                                                   FontSize="10.5"
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold" />
                                    </Grid>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding FileName}"
                                               Foreground="#E5E7EB"
                                               FontSize="11.5"
                                               Margin="1,1,1,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. OVERVIEW (THUMBNAIL GRID) ==================== -->
        <Grid x:Name="OverviewGrid"
              Background="{StaticResource AppBackgroundBrush}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#2D2D30"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="FastImageViewer"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <Border Background="#25252B"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="AppVersionText"
                                       Text="v1.2.0"
                                       Foreground="#9CA3AF"
                                       FontSize="11"
                                       FontFamily="Consolas" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="FolderPathText"
                               Grid.Column="1"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <ComboBox x:Name="OverviewSortComboBox"
                              Grid.Column="2"
                              Width="205"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="Změnit řazení obrázků ve složce"
                              Style="{StaticResource FilmstripComboBoxStyle}"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Řazení: Název A–Z (Přirozené)" />
                        <ComboBoxItem Content="Řazení: Název Z–A" />
                        <ComboBoxItem Content="Řazení: Datum (Nejnovější první)" />
                        <ComboBoxItem Content="Řazení: Datum (Nejstarší první)" />
                        <ComboBoxItem Content="Řazení: Velikost (Největší)" />
                    </ComboBox>

                    <Button Grid.Column="3"
                            Content="⚡ Dávková konverze (B)"
                            ToolTip="Dávková konverze a změna rozměrů obrázků (zkratka B nebo F3)"
                            Click="BatchConvertButton_Click"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Padding="12,5"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            VerticalAlignment="Center" />

                    <Button x:Name="EditSaveModeButton"
                            Grid.Column="4"
                            Content="Ukládání: Auto sufix (U)"
                            ToolTip="Přepnout režim ukládání otočení a výřezů: Automaticky se sufixem (_rotated / _cropped) vs. Dialog Uložit jako… (zkratka U)"
                            Click="EditSaveModeButton_Click"
                            Background="#2D2D30"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            Padding="12,5"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            VerticalAlignment="Center" />

                    <Button x:Name="WheelModeButton"
                            Grid.Column="5"
                            Content="Kolečko: Listování (M)"
                            ToolTip="Přepnout chování kolečka myši ve Fullscreenu: Listování mezi fotkami vs. Zoom (zkratka M; Ctrl+Kolečko vždy zoomuje)"
                            Click="WheelModeButton_Click"
                            Background="#2D2D30"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            Padding="12,5"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            VerticalAlignment="Center" />

                    <Button Grid.Column="6"
                            Content="Otevřít obrázek / složku (O)"
                            Click="OpenFileButton_Click"
                            Background="#2D2D30"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            Padding="12,5"
                            Margin="8,0,12,0"
                            Cursor="Hand"
                            VerticalAlignment="Center" />

                    <Button Grid.Column="7"
                            Content="✕"
                            ToolTip="Ukončit (Esc)"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0"
                            FontSize="15"
                            Width="32"
                            Height="32"
                            Cursor="Hand"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 3-Pane FastStone Workspace (Left: Folder Tree + Live Preview, Right: Thumbnail Grid) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="OverviewLeftColumn" Width="285" MinWidth="180" MaxWidth="650" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR: Folder Tree (Top) + Live Preview (Bottom) -->
                <Grid Grid.Column="0" Background="#18181B">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="100" />
                        <RowDefinition Height="6" />
                        <RowDefinition x:Name="OverviewPreviewRow" Height="235" MinHeight="100" />
                    </Grid.RowDefinitions>

                    <!-- TOP-LEFT: Folder Tree -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1E1E1E"
                                BorderBrush="#2D2D30"
                                BorderThickness="0,0,0,1"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="SLOŽKY"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="⟳"
                                        ToolTip="Obnovit strom složek"
                                        Click="RefreshFolderTreeButton_Click"
                                        Background="Transparent"
                                        Foreground="#9CA3AF"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Cursor="Hand"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TreeView x:Name="FolderTreeView"
                                  Grid.Row="1"
                                  Background="#18181B"
                                  BorderThickness="0"
                                  Padding="4,6"
                                  ItemContainerStyle="{StaticResource FolderTreeViewItemStyle}"
                                  SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                                  VirtualizingStackPanel.IsVirtualizing="False">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <TextBlock Text="{Binding Icon}" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>

                    <!-- HORIZONTAL SPLITTER (Tree vs Preview) -->
                    <GridSplitter Grid.Row="1"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="#252529"
                                  BorderBrush="#2D2D30"
                                  BorderThickness="0,1"
                                  Cursor="SizeNS" />

                    <!-- BOTTOM-LEFT: Dynamic Preview of Selected Photo -->
                    <Grid Grid.Row="2" Background="#121212">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#1E1E1E"
                                BorderBrush="#2D2D30"
                                BorderThickness="0,0,0,1"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="NÁHLED"
                                           Foreground="#9CA3AF"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock x:Name="OverviewPreviewMetaText"
                                           Grid.Column="1"
                                           Foreground="#60A5FA"
                                           FontSize="11.5"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Background="#0D0D0F"
                                Margin="6"
                                CornerRadius="5"
                                BorderBrush="#252529"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                ToolTip="Kliknutím přepnete do Fullscreenu (Enter)"
                                MouseLeftButtonDown="OverviewPreviewBorder_MouseLeftButtonDown">
                            <Image x:Name="OverviewPreviewImage"
                                   Stretch="Uniform"
                                   StretchDirection="DownOnly"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- VERTICAL SPLITTER (Left Sidebar vs Right Thumbnail Grid) -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="#252529"
                              BorderBrush="#2D2D30"
                              BorderThickness="1,0"
                              Cursor="SizeWE" />

                <!-- RIGHT PANE: Thumbnail Grid & Empty State -->
                <Grid Grid.Column="2">
                    <ListBox x:Name="ThumbnailListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12"
                             SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             SelectionChanged="ThumbnailListBox_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ImageItem}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#18181A"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding FileName}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Panel -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="Ve vybrané složce nejsou žádné podporované obrázky (JPG, JFIF, PNG, WEBP, BMP, TIFF, GIF, ICO, HEIC, AVIF)."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />
                        <Button Content="Vybrat obrázek ze souboru (O)"
                                Click="OpenFileButton_Click"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="18,9"
                                FontSize="13"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom Status Bar in Overview -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#2D2D30"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusCounterText"
                               Grid.Column="0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="Enter: Fullscreen  •  L/R/H/V: Rotace/Zrcadlo  •  X: Výstřižek  •  *: 100%  •  C: Kopírovat  •  Del: Koš"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Subtle auto-hiding toast for file actions & mode switches -->
        <Border x:Name="ToastBorder"
                Background="#DD1E1E1E"
                BorderBrush="#3B82F6"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8"
                Margin="24,24,24,42"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="ToastText"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13" />
        </Border>
    </Grid>
</Window>
