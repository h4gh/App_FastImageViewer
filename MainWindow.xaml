                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Fotoaparát / Model" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifModelText" Grid.Row="1" Grid.Column="1" Text="—" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Objektiv" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifLensText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Software" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifSoftwareText" Grid.Row="3" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Datum pořízení" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifDateTakenText" Grid.Row="4" Grid.Column="1" Text="—" Foreground="#F3F4F6" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Čas expozice" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifExposureTimeText" Grid.Row="5" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Clona" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifFNumberText" Grid.Row="6" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Citlivost (ISO)" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifIsoText" Grid.Row="7" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Expoziční program" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifExposureProgramText" Grid.Row="8" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Měření expozice" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifMeteringModeText" Grid.Row="9" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Kompenzace EV" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifExposureBiasText" Grid.Row="10" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Blesk" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifFlashText" Grid.Row="11" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Ohnisková vzdál." Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifFocalLengthText" Grid.Row="12" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Ekvivalent 35 mm" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifFocal35mmText" Grid.Row="13" Grid.Column="1" Text="—" Foreground="#E5E7EB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Vyvážení / Barvy" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifWhiteBalanceColorText" Grid.Row="14" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />

                                    <TextBlock Grid.Row="15" Grid.Column="0" Text="Orientace (EXIF)" Foreground="#8B92A1" FontSize="11" Margin="0,1.5" />
                                    <TextBlock x:Name="ExifOrientationText" Grid.Row="15" Grid.Column="1" Text="—" Foreground="#D1D5DB" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1.5" />
                                </Grid>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: GPS Location & Map Links -->
                    <Border x:Name="ExifGpsBorder"
