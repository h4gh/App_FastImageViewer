<Application x:Class="FastImageViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121212" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252526" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#333337" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
    </Application.Resources>
</Application>
