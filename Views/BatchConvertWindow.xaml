<Window x:Class="FastImageViewer.Views.BatchConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dávková konverze a změna rozměrů"
        Width="940"
        Height="590"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        BorderBrush="#3B82F6"
        BorderThickness="1"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Dark ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B3548" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#121212" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#9CA3AF" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E1E1E"
                                            BorderThickness="1"
                                            BorderBrush="#3B82F6"
                                            CornerRadius="5">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Dávková konverze a změna rozměrů"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Přetáhněte sem soubory myší (Drag &amp; Drop) nebo přidejte fotky ze složky"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="✕"
                    ToolTip="Zavřít (Esc)"
                    Click="CloseButton_Click"
                    Background="Transparent"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderThickness="0"
                    FontSize="15"
                    Width="32"
                    Height="32"
                    Cursor="Hand"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- ==================== MAIN 2-COLUMN CONTENT ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Input Files -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="InputFilesHeaderText"
                               Text="VSTUPNÍ SOUBORY (0)"
                               Foreground="#60A5FA"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SmallActionButtonStyle}"
                                Content="+ Přidat soubory…"
                                Click="AddFilesButton_Click"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource SmallActionButtonStyle}"
                                Content="+ Celá složka"
                                Click="AddCurrentFolderButton_Click"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource SmallActionButtonStyle}"
                                Content="Odebrat"
                                Click="RemoveSelectedButton_Click"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource SmallActionButtonStyle}"
                                Content="Vyčistit"
                                Foreground="#F87171"
                                Click="ClearFilesButton_Click" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#121212"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <ListBox x:Name="FilesListBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 SelectionMode="Extended"
                                 FontSize="12.5"
                                 Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FileName}"
                                                   Foreground="#F3F4F6"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="11.5"
                                                   Margin="12,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyFilesHintText"
                                   Text="Seznam je prázdný. Přetáhněte sem soubory myší nebo klikněte na „+ Přidat soubory…“"
                                   Foreground="#6B7280"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Width="280"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="Tip: Označené položky v seznamu můžete odebrat klávesou Delete."
                           Foreground="#6B7280"
                           FontSize="11.5"
                           Margin="2,6,0,0" />
            </Grid>

            <!-- RIGHT COLUMN: Settings -->
            <StackPanel Grid.Column="2">
                <!-- 1. Output Format & Quality -->
                <Border Background="#252526"
                        BorderBrush="#2D2D30"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. VÝSTUPNÍ FORMÁT A KOMPRESE"
                                   Foreground="#60A5FA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Výstupní formát:"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="FormatComboBox"
                                      Grid.Column="1"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      SelectionChanged="FormatComboBox_SelectionChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="JPEG (.jpg)" Tag="JPG" />
                                <ComboBoxItem Content="WebP (.webp)" Tag="WEBP" />
                                <ComboBoxItem Content="PNG (.png – bezeztrátový)" Tag="PNG" />
                            </ComboBox>
                        </Grid>

                        <StackPanel x:Name="QualityPanel">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Kvalita / Komprese:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBlock x:Name="QualityValueText"
                                           Grid.Column="1"
                                           Text="90 %"
                                           Foreground="#60A5FA"
                                           FontWeight="SemiBold"
                                           FontSize="12.5" />
                            </Grid>
                            <Slider x:Name="QualitySlider"
                                    Minimum="10"
                                    Maximum="100"
                                    Value="90"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="QualitySlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Resize Settings -->
                <Border Background="#252526"
                        BorderBrush="#2D2D30"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="EnableResizeCheckBox"
                                  IsChecked="False"
                                  Checked="EnableResizeCheckBox_Changed"
                                  Unchecked="EnableResizeCheckBox_Changed"
                                  Cursor="Hand"
                                  Margin="0,0,0,10">
                            <TextBlock Text="2. ZMĚNIT ROZMĚRY (ZACHOVAT POMĚR STRAN)"
                                       Foreground="#60A5FA"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </CheckBox>

                        <StackPanel x:Name="ResizeSettingsPanel" IsEnabled="False" Opacity="0.45">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Způsob změny:"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="ResizeModeComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          SelectionChanged="ResizeModeComboBox_SelectionChanged"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Delší strana (px)" Tag="PX" />
                                    <ComboBoxItem Content="Procenta (%)" Tag="PCT" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Předvolba:"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="ResizePresetComboBox"
                                          Grid.Column="1"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          SelectionChanged="ResizePresetComboBox_SelectionChanged" />
                            </Grid>

                            <!-- Custom Value Input (Visible only when 'Vlastní...' is selected) -->
                            <Grid x:Name="CustomResizeValueGrid" Visibility="Collapsed" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Vlastní hodnota:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="CustomResizeValueTextBox"
                                         Grid.Column="1"
                                         Text="1920"
                                         Background="#121212"
                                         Foreground="#F3F4F6"
                                         CaretBrush="#F3F4F6"
                                         BorderBrush="#3B82F6"
                                         BorderThickness="1"
                                         Padding="8,5"
                                         FontSize="12.5" />
                                <TextBlock x:Name="CustomResizeUnitText"
                                           Grid.Column="2"
                                           Text="px"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Margin="8,0,4,0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Output Folder -->
                <Border Background="#252526"
                        BorderBrush="#2D2D30"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="3. VÝSTUPNÍ SLOŽKA"
                                   Foreground="#60A5FA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OutputFolderTextBox"
                                     Grid.Column="0"
                                     Background="#121212"
                                     Foreground="#F3F4F6"
                                     CaretBrush="#F3F4F6"
                                     BorderBrush="#3E3E42"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource SmallActionButtonStyle}"
                                    Content="Procházet…"
                                    Click="BrowseOutputFolderButton_Click"
                                    Padding="12,6"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== BOTTOM PROGRESS & ACTION BAR ==================== -->
        <Border Grid.Row="2"
                BorderBrush="#2D2D30"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressStatusText"
                                   Grid.Column="0"
                                   Text="Připraveno ke konverzi"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProgressPercentText"
                                   Grid.Column="1"
                                   Text="0 %"
                                   Foreground="#60A5FA"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Grid>
                    <ProgressBar x:Name="ConversionProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#121212"
                                 Foreground="#3B82F6"
                                 BorderBrush="#2D2D30"
                                 BorderThickness="1" />
                </StackPanel>

                <Button Grid.Column="1"
                        Click="CloseButton_Click"
                        Background="#2D2D30"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        Padding="16,9"
                        Margin="0,0,10,0"
                        Cursor="Hand">
                    <TextBlock Text="Zavřít (Esc)" />
                </Button>

                <Button x:Name="StartConvertButton"
                        Grid.Column="2"
                        Click="StartConvertButton_Click"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Padding="20,9"
                        Cursor="Hand">
                    <TextBlock x:Name="StartConvertButtonText" Text="▶ Spustit konverzi" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
