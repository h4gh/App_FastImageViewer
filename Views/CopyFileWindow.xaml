<Window x:Class="FastImageViewer.Views.CopyFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kopírovat soubor"
        Width="520"
        Height="210"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        BorderBrush="#3B82F6"
        BorderThickness="1"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Kopírovat soubor do složky"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="SourceFileNameText"
                   Grid.Row="1"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TargetFolderTextBox"
                     Grid.Column="0"
                     Background="#121212"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}"
                     BorderBrush="#3E3E42"
                     BorderThickness="1"
                     Padding="10,7"
                     FontSize="13"
                     VerticalContentAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Procházet..."
                    Click="BrowseButton_Click"
                    Background="#2D2D30"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    Padding="14,7"
                    Margin="8,0,0,0"
                    Cursor="Hand" />
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   Foreground="#EF4444"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Zrušit (Esc)"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Background="#2D2D30"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    Padding="16,7"
                    Margin="0,0,8,0"
                    Cursor="Hand" />

            <Button Content="Kopírovat (Enter)"
                    IsDefault="True"
                    Click="ConfirmButton_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Padding="18,7"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
