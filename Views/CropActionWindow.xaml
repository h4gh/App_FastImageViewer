<Window x:Class="FastImageViewer.Views.CropActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Výstřižek"
        MinWidth="540"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        BorderBrush="#3B82F6"
        BorderThickness="1"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Výstřižek obrazu"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="15"
                       FontWeight="SemiBold" />

            <TextBlock x:Name="CropDimensionsText"
                       Grid.Column="1"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Preview of the cropped region -->
        <Border Grid.Row="1"
                Height="210"
                Background="#121212"
                BorderBrush="#2D2D30"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0,0,0,12">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <TextBlock x:Name="TargetFileInfoText"
                   Grid.Row="2"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12.5"
                   Margin="0,0,0,14" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   Foreground="#EF4444"
                   FontSize="12"
                   Margin="0,0,0,10"
                   Visibility="Collapsed" />

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Background="#2D2D30"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    Padding="14,8"
                    Cursor="Hand">
                <TextBlock Text="Zrušit (Esc)" />
            </Button>

            <Button Grid.Column="2"
                    Click="CopyToClipboardButton_Click"
                    Background="#2D2D30"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Cursor="Hand">
                <TextBlock Text="Do schránky (C)" />
            </Button>

            <Button Grid.Column="3"
                    IsDefault="True"
                    Click="SaveToFileButton_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Padding="18,8"
                    Cursor="Hand">
                <TextBlock x:Name="SaveButtonText" Text="Uložit _cropped (Enter)" />
            </Button>
        </Grid>
    </Grid>
</Window>
