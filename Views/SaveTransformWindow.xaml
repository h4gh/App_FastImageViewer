<Window x:Class="FastImageViewer.Views.SaveTransformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uložit upravený obrázek"
        MinWidth="600"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        BorderBrush="#3B82F6"
        BorderThickness="1"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Uložit otočenou / převrácenou fotografii?"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="InfoText"
                   Grid.Row="1"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="13"
                   LineHeight="20"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Background="#2D2D30"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Cursor="Hand">
                <TextBlock Text="Zrušit (Esc)" />
            </Button>

            <Button Grid.Column="1"
                    Click="DiscardButton_Click"
                    Background="#2D2D30"
                    Foreground="#F87171"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    Padding="14,8"
                    Cursor="Hand">
                <TextBlock Text="Neukládat (D)" />
            </Button>

            <Button Grid.Column="3"
                    Click="OverwriteButton_Click"
                    Background="#2D2D30"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Cursor="Hand">
                <TextBlock Text="Přepsat originál (P)" />
            </Button>

            <Button Grid.Column="4"
                    IsDefault="True"
                    Click="SaveAsNewButton_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Padding="18,8"
                    Cursor="Hand">
                <TextBlock x:Name="SaveNewButtonText" Text="Jako novou _rotated (Enter)" />
            </Button>
        </Grid>
    </Grid>
</Window>
